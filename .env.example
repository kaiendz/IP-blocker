# Copy to .env and fill in real values before running docker-compose.
# Never commit the real .env file.

# --- Postgres (used by both the "db" and "backend" services in docker-compose.yml) ---
POSTGRES_USER=blacklister
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=blacklister
DATABASE_URL=postgresql+psycopg://blacklister:change-me-strong-password@db:5432/blacklister

# --- JWT signing secret — generate with: openssl rand -hex 32 ---
SECRET_KEY=change-me-generate-a-random-64-char-hex-string

# --- Fernet key used to encrypt stored secrets (FortiGate tokens, FortiCloud
# credentials, Azure connection string, threat-intel API keys) at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-fernet-key

# --- Bootstrap admin account, created on first startup only ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately-after-first-login

# --- CORS: origins allowed to call the API (JSON array) ---
CORS_ORIGINS=["http://localhost:8080"]
